---
import GlassLab from '../../_shared/glass-lab/GlassLab.astro';
import { SAMPLE_TOKENS } from './model';
---
<GlassLab id="qwen3-8-flash-next" title="Qwen3.8-Flash-Next · giải phẫu kiến trúc hybrid" label="Hoạt cảnh kiến trúc Qwen3.8-Flash-Next: lịch 48 layer, tham số tổng và kích hoạt, bộ nhớ ngữ cảnh dài, MoE routing, Gated Residual, n-gram và MTP"
  chapters={['48 layer', 'Tham số', 'Ngữ cảnh dài', 'MoE routing', 'Gated Residual', 'N-gram & MTP']}
  data="Lịch layer, số head, ngân sách QSA, số expert, kích thước bộ nhớ và số tham số tính từ model card, config.json và báo cáo kỹ thuật của Qwen3.8-Flash-Next (KV cache bf16 cho một chuỗi, chưa gồm key của indexer, trạng thái convolution và activation)."
  scope="Expert được chọn, trọng số router, vector residual và chuỗi token nháp của MTP là minh họa có seed cố định, không phải suy luận từ trọng số Qwen. Phần “khác ≈” trong chương Tham số là phần còn lại của 6B kích hoạt công bố.">
  <Fragment slot="controls">
    <label class="field" data-chapters="2"><span class="field-row"><span>Độ dài ngữ cảnh</span><output data-value="context"></output></span><input type="range" name="context" min="0" max="4" step="1" value="3" /></label>
    <div class="field" data-chapters="3">Token<div class="chips">{SAMPLE_TOKENS.map(tok => <button type="button" data-token={tok} aria-pressed={tok === 'attention' ? 'true' : 'false'}>{tok}</button>)}</div></div>
    <label class="field" data-chapters="3"><span class="field-row"><span>Layer</span><output data-value="layer"></output></span><input type="range" name="layer" min="1" max="48" step="1" value="6" /></label>
  </Fragment>
</GlassLab>
<script>
  import { initQwenLab } from './render';
  initQwenLab();
</script>
