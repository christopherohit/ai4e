---
import GlassLab from '../../_shared/glass-lab/GlassLab.astro';
---
<GlassLab id="sparse-attention" title="Sparse attention · chỉ đọc phần ngữ cảnh đáng đọc" label="Hoạt cảnh sparse attention: bản đồ attention thật, attention sink, cửa sổ cục bộ, Qwen Sparse Attention chọn block, độ phủ đo thật"
  chapters={['Bản đồ thật', 'Một hàng', 'Mẫu cố định', 'QSA từng bước', 'Đo độ phủ']}
  data="Chương 1, 2, 3, 5 là số đo thật: một lượt chạy Qwen2.5-0.5B-Instruct (attention eager, CPU) trên 1 024 token WikiText-2, so sánh softmax dense của 24 layer × 14 head với tập token mà từng mẫu thưa sẽ đọc (scripts/llm-bake/sparse_attention.py). Chương 4 là ví dụ 32 token dựng sẵn."
  scope="Qwen2.5-0.5B không được huấn luyện với sparse attention: phép đo cho biết mẫu thưa giữ được bao nhiêu khối lượng attention của một mô hình dense, không phải chất lượng của Qwen3.8 với QSA (có indexer huấn luyện riêng, ngân sách 2 048 token). Chọn block ở đây dùng q · key trung bình của chính head đó.">
  <Fragment slot="controls">
    <div class="field" data-chapters="0,1,2">Head<div class="chips">
      <button type="button" data-pic="0" aria-pressed="false">L1 H1</button><button type="button" data-pic="1" aria-pressed="false">L7 H4</button><button type="button" data-pic="2" aria-pressed="true">L14 H6</button><button type="button" data-pic="3" aria-pressed="false">L24 H11</button>
    </div></div>
    <label class="field" data-chapters="2"><span class="field-row"><span>Ngân sách cửa sổ</span><output data-value="window"></output></span><input type="range" name="window" min="0" max="2" step="1" value="0" /></label>
    <label class="field" data-chapters="3"><span class="field-row"><span>Số block giữ</span><output data-value="toy"></output></span><input type="range" name="toy" min="1" max="6" step="1" value="2" /></label>
    <label class="field" data-chapters="4"><span class="field-row"><span>Ngân sách token</span><output data-value="budget"></output></span><input type="range" name="budget" min="0" max="2" step="1" value="0" /></label>
  </Fragment>
</GlassLab>
<script>
  import { initSparseAttentionLab } from './render';
  initSparseAttentionLab();
</script>
