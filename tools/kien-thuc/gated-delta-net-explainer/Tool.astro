---
import GlassLab from '../../_shared/glass-lab/GlassLab.astro';
---
<GlassLab id="gated-delta-net" title="Gated DeltaNet · bộ nhớ trạng thái thay cho KV cache" label="Hoạt cảnh Gated DeltaNet: bộ nhớ theo độ dài ngữ cảnh, delta rule từng bước, dung lượng trạng thái, cổng quên và lý do dùng hybrid"
  chapters={['Bộ nhớ', 'Delta rule', 'Dung lượng', 'Cổng quên', 'Vì sao hybrid']}
  data="Chương 1 tính bộ nhớ từ cấu hình công bố của Qwen3.8-Flash-Next (config.json, bf16). Chương 2–5 là thí nghiệm số chạy trong trình duyệt: ma trận 4×4 với key/value dựng sẵn, và ma trận 32×32 với key/value ngẫu nhiên có seed cố định."
  scope="Không có trọng số Qwen nào được chạy: các thí nghiệm số minh họa đúng công thức cập nhật (linear attention, delta rule, gated delta rule) trên vector nhỏ. Trong GDN thật, α và β được tính từ token đầu vào, có nhiều head, convolution ngắn, RMSNorm và output gate.">
  <Fragment slot="controls">
    <label class="field" data-chapters="1"><span class="field-row"><span>Decay α</span><output data-value="alpha"></output></span><input type="range" name="alpha" min="0.5" max="1" step="0.01" value="0.95" /></label>
    <label class="field" data-chapters="1"><span class="field-row"><span>Cường độ ghi β</span><output data-value="beta"></output></span><input type="range" name="beta" min="0.1" max="1" step="0.05" value="0.9" /></label>
    <div class="field" data-chapters="3">Chế độ cổng quên<div class="chips"><button type="button" data-gate="1" aria-pressed="false">α = 1</button><button type="button" data-gate="0.9" aria-pressed="false">α = 0,9</button><button type="button" data-gate="switch" aria-pressed="true">theo dữ liệu</button></div></div>
  </Fragment>
</GlassLab>
<script>
  import { initGatedDeltaNetLab } from './render';
  initGatedDeltaNetLab();
</script>
