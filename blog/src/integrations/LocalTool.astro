---
import NerfExplainer from '../../../tools/kien-thuc/nerf-explainer/Tool.astro';
import GaussianSplattingExplainer from '../../../tools/kien-thuc/gaussian-splatting-explainer/Tool.astro';
import SyncTalk from '../../../tools/du-an/synctalk/Tool.astro';
import InsTaG from '../../../tools/du-an/instag/Tool.astro';
import SdvxModeler from '../../../tools/du-an/sdvx-modeler/Tool.astro';
import Bswmd from '../../../tools/du-an/bswmd/Tool.astro';
import MedlabBodyAtlas from '../../../tools/du-an/medlab-body-atlas/Tool.astro';
import QwenExplainer from '../../../tools/kien-thuc/qwen3-8-flash-next-explainer/Tool.astro';
import GatedDeltaNetExplainer from '../../../tools/kien-thuc/gated-delta-net-explainer/Tool.astro';
import SparseAttentionExplainer from '../../../tools/kien-thuc/sparse-attention-explainer/Tool.astro';
import GradientDescentExplainer from '../../../tools/kien-thuc/gradient-descent-explainer/Tool.astro';
import MiniBatchSgdExplainer from '../../../tools/kien-thuc/mini-batch-sgd-explainer/Tool.astro';
import NaiveBayesExplainer from '../../../tools/kien-thuc/naive-bayes-explainer/Tool.astro';
import SvmExplainer from '../../../tools/kien-thuc/svm-explainer/Tool.astro';
import BiasVarianceExplainer from '../../../tools/kien-thuc/bias-variance-explainer/Tool.astro';
import RegularizationExplainer from '../../../tools/kien-thuc/regularization-explainer/Tool.astro';

import ActivationExplainer from '../../../tools/kien-thuc/activation-explainer/Tool.astro';
import PcaExplainer from '../../../tools/kien-thuc/pca-explainer/Tool.astro';
const components = {
  'qwen3-8-flash-next-explainer': QwenExplainer,
  'gated-delta-net-explainer': GatedDeltaNetExplainer,
  'sparse-attention-explainer': SparseAttentionExplainer,
  'gradient-descent-explainer': GradientDescentExplainer,
  'mini-batch-sgd-explainer': MiniBatchSgdExplainer,
  'naive-bayes-explainer': NaiveBayesExplainer,
  'svm-explainer': SvmExplainer,
  'bias-variance-explainer': BiasVarianceExplainer,
  'regularization-explainer': RegularizationExplainer,
  'nerf-explainer': NerfExplainer,
  'gaussian-splatting-explainer': GaussianSplattingExplainer,
  synctalk: SyncTalk,
  instag: InsTaG,
  'sdvx-modeler': SdvxModeler,
  bswmd: Bswmd,
  'medlab-body-atlas': MedlabBodyAtlas,
  'activation-explainer': ActivationExplainer,
  'pca-explainer': PcaExplainer,
};
interface Props { slug: string }
const { slug } = Astro.props;
const Tool = components[slug as keyof typeof components];
if (!Tool) throw new Error(`Unknown local tool: ${slug}`);
---
<Tool />
