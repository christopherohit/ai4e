---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TagChip from '../components/TagChip.astro';
import Toc from '../components/Toc.astro';
import VizEmbed from '../components/VizEmbed.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES } from '../lib/site';
import { postReadingTime, formatDateVi } from '../lib/posts';
import { readingTimeLabel } from '../lib/reading-time';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  related: CollectionEntry<'posts'>[];
}
const { post, headings, related } = Astro.props;
const { title, description, category, tags, cover, viz, vizHeight, date } = post.data;
const cat = CATEGORIES[category];
// Articles may place their own embed next to the introduction.
const hasInlineEmbed = /<VizEmbed\b/.test(post.body ?? '');
---

<BaseLayout title={title} description={description} ogImage={cover.src}>
  <article class="container section">
    <Breadcrumb items={[{ label: 'Trang chủ', href: '/' }, { label: cat.label, href: cat.href }, { label: title }]} />
    <header class="post-header stack">
      <div class="chips">{tags.map(tag => <TagChip tag={tag} />)}</div>
      <p class="muted">{readingTimeLabel(postReadingTime(post))} · <time datetime={date.toISOString()}>{formatDateVi(date)}</time></p>
      <h1>{title}</h1>
      <p class="post-description">{description}</p>
    </header>
    {viz && !hasInlineEmbed && <div class="post-viz" id="cong-cu"><VizEmbed viz={viz} title={title} height={vizHeight} /></div>}
    <div class="post-mobile-toc"><Toc headings={headings} variant="inline" /></div>
    <div class="post-columns">
      <div class="post-body">
        <div class="prose"><slot /></div>
      </div>
      <aside class="post-sidebar"><Toc headings={headings} /></aside>
    </div>
  </article>
  {related.length > 0 && <section class="container section" aria-labelledby="related-title">
    <h2 class="section-title" id="related-title">Bài liên quan</h2>
    <div class="grid related-grid">{related.map(item => <PostCard post={item} />)}</div>
  </section>}
</BaseLayout>

<style>
  .post-header { max-width: 900px; padding-block: var(--space-8); }
  h1 { font-size: clamp(2rem, 4vw, 3rem); text-wrap: balance; }
  .post-description { font-size: var(--text-xl); color: var(--color-text-2); }
  .post-viz { margin-bottom: var(--space-8); }
  .post-columns { display: grid; gap: var(--space-10); }
  .post-body { min-width: 0; }
  .post-body .prose { max-width: 100%; }
  .post-sidebar { display: none; min-width: 0; }
  .post-mobile-toc { margin-bottom: var(--space-6); }
  .related-grid { margin-top: var(--space-6); }
  @media (min-width: 1024px) {
    .post-columns { grid-template-columns: minmax(0, 1fr) 240px; }
    .post-sidebar { display: block; }
    .post-mobile-toc { display: none; }
  }
</style>
